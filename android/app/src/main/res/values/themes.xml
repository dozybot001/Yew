<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: Yew's paper colour, light or dark with the system. -->
    <style name="Theme.Yew" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#FFFFFF</color>
    <!-- The leaf of Yew's mark and its wordmark: dark green, light grey-green in the dark. -->
    <color name="mark_ink">#1F3A2E</color>
</resources>

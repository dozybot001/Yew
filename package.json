{
	"name": "@tenonai/yew",
	"version": "1.11.0",
	"description": "An AI-native multi-agent workbench",
	"keywords": [
		"agent",
		"ai",
		"multi-agent",
		"workbench",
		"cli"
	],
	"license": "MIT",
	"author": "Tenon AI (https://tenonai.cn/)",
	"homepage": "https://tenonai.cn/products/yew/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dozybot001/Yew.git"
	},
	"bugs": {
		"url": "https://github.com/dozybot001/Yew/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"yew": "bin/yew.js"
	},
	"exports": {
		"./sim": {
			"types": "./dist/sim/index.d.ts",
			"default": "./dist/sim/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"dist",
		"web/dist",
		"mcp-builtin",
		"skills-builtin",
		"THIRD-PARTY-NOTICES.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit -p . && tsc --noEmit -p web && npm test",
		"test": "node --test \"test/**/*.test.ts\"",
		"format": "biome check --write .",
		"build:web": "vite build --config web/vite.config.ts",
		"build:mac": "node scripts/mac-app.mjs",
		"watch:web": "vite build --config web/vite.config.ts --watch",
		"relay:publish": "bash deploy/relay/publish.sh",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && npm run build:web && npm run build:mac && node scripts/notices.mjs && tsc -p tsconfig.sim.json && node scripts/sim-types.mjs",
		"prepack": "npm run build",
		"audit:gate": "node scripts/audit-gate.mjs",
		"audit:install": "node scripts/install-check.mjs",
		"install:local": "node scripts/install-local.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.2.1",
		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.83",
		"@earendil-works/pi-ai": "1.5.0",
		"@hono/node-server": "2.1.6",
		"@napi-rs/keyring": "2.1.2",
		"diff": "9.0.0",
		"hono": "4.13.17",
		"htmlparser2": "12.0.0",
		"image-size": "2.1.0",
		"pdfjs-dist": "6.5.438",
		"uqr": "0.1.3",
		"ws": "8.22.0"
	},
	"bundleDependencies": [
		"@anthropic-ai/sandbox-runtime"
	],
	"overrides": {
		"@anthropic-ai/sandbox-runtime": {
			"zod": "4.6.6"
		}
	}
}
